    {
      "at_utc": "2026-10-24T11:47:00.255Z",
      "kind": "propose",
      "attempt": 4,
      "duration_ms": 8784,
      "diagnosis": "The date field accepts manual entry but flatpickr expects YYYY-MM-DD; typing DD/MM/YYYY results in an incorrect or unset date, causing the booked date to shift. Making the field focusable and converting DD/MM/YYYY to YYYY-MM-DD on Enter ensures the correct date is used.",
      "edits": [
        {
          "path": "assets/js/pages/booking.js",
          "old": "App.Utils.UI.setDateTimePickerValue($selectDate, new Date());",
          "new": "App.Utils.UI.setDateTimePickerValue($selectDate, new Date());\n        $selectDate.attr('tabindex', '0').on('keyup', function (e) {\n            if (e.key === 'Enter') {\n                var val = $(this).val();\n                var parts = val.split('/');\n                if (parts.length === 3) {\n                    var day = parts[0];\n                    var month = parts[1];\n                    var year = parts[2];\n                    if (day.length === 2 && month.length === 2 && year.length === 4) {\n                        val = year + '-' + month + '-' + day;\n                        $(this).val(val);\n                    }\n                }\n                $selectDate.trigger('change');\n            }\n        });"
        }
      ],
